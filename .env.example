# Veynor — shared provider API keys.
# Copy this file to .env and fill only the keys you need.
# Do not commit real tokens or API keys.

# ── LLM backend ──────────────────────────────────────────────────
# Optional OpenAI-compatible LLM endpoint used by setup/start integrations.
# Leave blank for echo-only tests or mock/local agents.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=

# ── OpenClaw Integration ─────────────────────────────────────────
# Local CLI path or HTTP endpoint for OpenClaw agent backend.
OPENCLAW_MJS=
OPENCLAW_AGENT=main
OPENCLAW_URL=

# ── STT (Groq Whisper) ──────────────────────────────────────────
# GroqCloud Speech-to-Text. Required only when transcribing user speech.
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=zh

# ── TTS / LLM (MiniMax) ─────────────────────────────────────────
# Recommended low-cost shared provider for LLM + TTS.
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_LLM_MODEL=MiniMax-M3

# ── Per-Agent Discord ──────────────────────────────────────────
# Each agent has its own DISCORD_BOT_TOKEN in agents/<id>/.env
# Use `veynor agent add <id> --directory agents/<id> --discord-token <token>`
# to create a self-contained agent with its own Discord bot identity.
